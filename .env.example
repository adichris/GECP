# Copy to .env. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
SECRET_KEY=development-only-change-this-before-deployment
DATABASE_URL=postgres://gecp:gecp-local-only@db:5432/gecp
POSTGRES_DB=gecp
POSTGRES_USER=gecp
POSTGRES_PASSWORD=gecp-local-only
ALLOWED_HOSTS=localhost,.localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://*.localhost:8000
ADMIN_BASE_URL=http://localhost:8000
TRUST_PROXY_SSL_HEADER=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=webmaster@localhost

# Required for real account recovery email (console backend is preview-only).
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Only exact proxy peer addresses that overwrite X-Real-IP. Empty means do not trust forwarded IPs.
TRUSTED_PROXY_IPS=

# App behaviour (media serving, submission notifications): config/settings/local.py.example
