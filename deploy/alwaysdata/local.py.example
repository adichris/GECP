"""Server settings. `deploy.sh setup` copies this to config/settings/local.py in the site
directory (git-ignored, chmod 600). Edit it on the server, then restart the site.

Plain Python, loaded after .env, so it can also hold the database and email server, e.g.
DATABASES = {'default': {'ENGINE': 'django.db.backends.postgresql', 'NAME': ..., 'USER': ...,
'PASSWORD': ..., 'HOST': ..., 'PORT': '5432'}} or EMAIL_HOST = ... .
Production safety rules (DEBUG off, HTTPS, PostgreSQL, ALLOWED_HOSTS) still apply after this file.
"""

# Media: the app serves public images itself. Set False only if alwaysdata static sites
# already serve /media/images/ and /media/staff/.
SERVE_MEDIA = True
MEDIA_CACHE_SECONDS = 60 * 60 * 24 * 30

# Contact and application notifications; empty list = the site's programme contact address.
SUBMISSION_EMAILS_ENABLED = True
SUBMISSION_NOTIFY_EMAILS = []
