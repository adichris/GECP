# Server .env for alwaysdata. `deploy.sh setup` copies this to ~/gecp/shared/.env
# (chmod 600) and fills SECRET_KEY. Replace every other placeholder ON THE SERVER.
# Never commit the real file. Values are read literally: do not add quotes or `export`.

# --- Django core ---------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
# Foundation domain plus every programme subdomain (leading dot = all subdomains).
ALLOWED_HOSTS=YOUR_DOMAIN,.YOUR_DOMAIN
CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN,https://*.YOUR_DOMAIN
# Used in admin links (including submission alert emails).
ADMIN_BASE_URL=https://YOUR_DOMAIN

# --- Database (alwaysdata PostgreSQL) -----------------------------------
# URL-encode special characters in the user and password.
DATABASE_URL=postgres://DB_USER:URL_ENCODED_PASSWORD@postgresql-ACCOUNT.alwaysdata.net:5432/DB_NAME

# --- Proxy and client IPs -------------------------------------------------
# alwaysdata's front proxy sets X-Forwarded-Proto; required for HTTPS detection.
TRUST_PROXY_SSL_HEADER=True
# Only exact, verified proxy peer IPs that overwrite X-Real-IP. Empty = trust nothing.
TRUSTED_PROXY_IPS=

# --- Email (password recovery, submission receipts and staff alerts) -----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-ACCOUNT.alwaysdata.net
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR_SMTP_USER
EMAIL_HOST_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GECP Foundation <no-reply@YOUR_DOMAIN>

# App behaviour (media serving, submission notifications) lives in shared/local.py,
# created from deploy/alwaysdata/local.py.example. Keep this file for secrets and infrastructure.
