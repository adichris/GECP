# Copy to project .env ON THE SERVER. Replace every placeholder.
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DATABASE_URL=postgres://DB_USER:URL_ENCODED_PASSWORD@postgresql-ACCOUNT.alwaysdata.net:5432/DB_NAME
ALLOWED_HOSTS=YOUR_DOMAIN,.YOUR_DOMAIN
CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN,https://*.YOUR_DOMAIN
ADMIN_BASE_URL=https://YOUR_DOMAIN
TRUST_PROXY_SSL_HEADER=True
# Set only verified proxy peer IPs if REMOTE_ADDR is a proxy, not the visitor.
TRUSTED_PROXY_IPS=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=YOUR_SMTP_HOST
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR_SMTP_USER
EMAIL_HOST_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GECP Foundation <YOUR_VERIFIED_SENDER>
