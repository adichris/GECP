# Local settings for deploy/alwaysdata/deploy.sh.
# Copy to deploy/alwaysdata/deploy.env (git-ignored) and fill in.
# This file is read on YOUR machine only; it is never uploaded.

# alwaysdata account name (the ACCOUNT in ssh-ACCOUNT.alwaysdata.net).
ALWAYSDATA_ACCOUNT=ACCOUNT
# Optional overrides; defaults are derived from the account name.
#SSH_HOST=ssh-ACCOUNT.alwaysdata.net
#SSH_USER=ACCOUNT
#SSH_PORT=22

# Where releases live on the server, relative to the account home (or an absolute path).
REMOTE_ROOT=gecp

# Python version on the server (alwaysdata selects it with PYTHON_VERSION).
PYTHON_VERSION=3.12

# Foundation domain, used for the post-deploy health check (https://DOMAIN/healthz/).
DOMAIN=YOUR_DOMAIN

# Python WSGI site ID (Web > Sites, shown in the site's URL) for automatic restarts.
SITE_ID=
# Do NOT put the API key here. Export it in your shell for the deploy:
#   export ALWAYSDATA_API_KEY=...   (Profile > API keys)
# Without it, the script prints a reminder to restart the site in the panel.

# Releases to keep on the server (current and previous are never removed).
KEEP_RELEASES=5
# Database backups to keep in ~/gecp/shared/backups.
BACKUP_KEEP=14
