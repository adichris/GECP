# Optional settings for deploy/alwaysdata/deploy.sh, read from the site directory on the server.
# Copy to deploy/alwaysdata/deploy.env (git-ignored). Every value can also come from the environment.

# Python version on the server (alwaysdata selects the interpreter with PYTHON_VERSION).
PYTHON_VERSION=3.12

# Domain for the post-deploy health check (https://DOMAIN/healthz/). Empty = skip.
DOMAIN=

# Command that restarts the app after a deploy. Empty = print a reminder to restart the site
# in the hosting panel.
RESTART_COMMAND=

# Database/media backups: kept outside the web root. Default: ~/backups/<site directory name>.
#BACKUP_DIR=
BACKUP_KEEP=14
