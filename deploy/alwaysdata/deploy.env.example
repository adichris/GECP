# Local settings for deploy/alwaysdata/deploy.sh.
# Copy to deploy/alwaysdata/deploy.env (git-ignored) and fill in.
# Read on YOUR machine only; never uploaded. No hosting account name or API key is needed.

# Where to deploy: exactly what you type after `ssh` today. A user@host pair, or a Host alias
# from ~/.ssh/config (that is where a custom port or key belongs).
DEPLOY_HOST=user@ssh.example.net

# Where releases live on the server, relative to your home directory (or an absolute path).
REMOTE_ROOT=gecp

# Python version on the server (alwaysdata selects it with PYTHON_VERSION).
PYTHON_VERSION=3.12

# Optional: domain for the post-deploy health check (https://DOMAIN/healthz/). Leave empty to skip.
DOMAIN=

# Optional: a command run on the server after each deploy or rollback to restart the app.
# Leave empty to get a reminder to restart the site in the hosting panel instead.
RESTART_COMMAND=

# Optional: log file shown by `deploy.sh logs` (default: the newest ~/admin/logs/uwsgi/*.log).
LOG_FILE=

# Releases to keep on the server (current and previous are never removed).
KEEP_RELEASES=5
# Database backups to keep in ~/gecp/shared/backups.
BACKUP_KEEP=14
