# Install on the host; replace example.org and certificate paths.
map $request_method $gecp_limit_key {
    default "";
    POST $binary_remote_addr;
}
limit_req_zone $gecp_limit_key zone=gecp_forms:10m rate=5r/m;
server {
    listen 80;
    server_name example.org *.example.org;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name example.org *.example.org;
    ssl_certificate /etc/letsencrypt/live/example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.org/privkey.pem;
    client_max_body_size 22m;
    # Wagtail document requests go through Django for access checks.
    location /media/ {
        alias /srv/gecp/media/;
        add_header X-Content-Type-Options nosniff always;
        # Original documents must never bypass Wagtail's serve view.
        location ~ ^/media/documents/ { deny all; }
        location ~* \.(html|htm|svg|js)$ { deny all; }
    }
    location ~ ^/(contact|apply|participate|accounts|community|admin/login|operations/login)/ {
        limit_req zone=gecp_forms burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
